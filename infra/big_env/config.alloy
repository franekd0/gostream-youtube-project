discovery.docker "gostream" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=gostream-preview"]
  }
}

discovery.relabel "gostream" {
  targets = discovery.docker.gostream.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "gostream" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.gostream.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
